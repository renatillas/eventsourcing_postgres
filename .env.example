# Example .env file for eventsourcing_postgres CLI
# Copy this to .env and modify for your database configuration

# Database connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=eventsourcing_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_POOL_NAME=eventsourcing_cli

# For production, use secure values:
# POSTGRES_HOST=your-production-host.com
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=production_db
# POSTGRES_USER=app_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_POOL_NAME=production_pool